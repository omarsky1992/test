# Copy to deploy/.env and fill in. Never commit the real file.
APP_NAME="نظام المشتركين"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_DOMAIN=subs.example.com
APP_URL=https://subs.example.com
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_TIMEZONE=Asia/Baghdad

DB_DATABASE=subs
DB_USERNAME=subs
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# First administrator, created on the first seed. Change the password after signing in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Daily backup to Google Drive (see docs/free-hosting.md, step 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BACKUP_TRIGGER_TOKEN=
BACKUP_KEEP_DAYS=30

# WhatsApp control panel (Meta WhatsApp Cloud API). Leave empty to keep it off.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
# Understanding free text and purchases (Claude API key from console.anthropic.com)
ANTHROPIC_API_KEY=
WHATSAPP_AI_MODEL=claude-opus-5-5
# Voice notes to text (OpenAI-compatible transcription endpoint)
OPENAI_API_KEY=
WHATSAPP_TRANSCRIBE_MODEL=whisper-1
